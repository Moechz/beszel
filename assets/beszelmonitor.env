# ============================================================
# Beszel Monitor Hub 配置（systemd EnvironmentFile）
# 改完执行: systemctl restart beszelmonitor
# 完整变量列表: https://beszel.dev/guide/environment-variables
# ============================================================

# 监听：固定 127.0.0.1:8090（写在 systemd unit 的 ExecStart 里，不在此配置；
# 原因：systemd ExecStart 不支持 shell 风格默认值展开。如需修改，编辑
# /etc/systemd/system/beszelmonitor.service 后 systemctl daemon-reload 并重启）

# 应用外部地址（通知邮件/OAuth 回调里的链接用）
# 安装时已按检测到的 IP 自动追加在文件末尾；IP 变化或改用域名时请更新
# APP_URL=https://192.168.1.10/beszelmonitor/

# ---- 可选：自动创建首个管理员（否则首次打开网页时手动创建）----
# USER_EMAIL=admin@example.com
# USER_PASSWORD=请改成强密码

# ---- 可选：所有用户共享全部系统（家庭单管理员场景可开）----
# SHARE_ALL_SYSTEMS=false

# ---- 可选：允许联网检查新版本提示（仅提示；升级请用应用中心新 deb）----
# CHECK_UPDATES=false
