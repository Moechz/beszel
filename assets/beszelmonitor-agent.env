# ============================================================
# Beszel Monitor Agent 配置（systemd EnvironmentFile）
# 改完执行: systemctl restart beszelmonitor-agent
# 完整变量列表: https://beszel.dev/guide/environment-variables
# ============================================================

# 注意：未配置 TOKEN 或 KEY 时 beszel-agent 会启动即退出（upstream 行为），
# 属正常——本包在未配置时不启动该服务，配好令牌 restart 即接入。
#
# ---- 连接本机 hub（推荐：出站 WebSocket 模式，全程走回环，无对外端口）----
# 1. 打开 Beszel 网页 → 设置 → 令牌 → 创建通用令牌
# 2. 取消下行注释并填入令牌，重启服务后 agent 自动注册本机
HUB_URL=http://127.0.0.1:8090
#TOKEN=把通用令牌填在这里

# ---- 备选：hub → agent SSH 模式（与 TOKEN 二选一）----
# 在网页"添加系统"时 Host/IP 填 127.0.0.1、端口填下方 LISTEN 的端口，
# 把显示的公钥填到 KEY（整行含引号）
#KEY="ssh-ed25519 AAAA..."

# agent SSH 服务监听地址（仅 hub→agent 模式使用；默认只监听本机回环）
LISTEN=127.0.0.1:45876

# agent 持久数据目录（系统指纹缓存）
DATA_DIR=/var/lib/beszelmonitor/agent

# ---- 可选：监控额外磁盘（默认只统计根分区；逗号分隔设备/分区/挂载点）----
# EXTRA_FILESYSTEMS=sdb,sdc1

# ---- 可选：Docker 监控 ----
# 默认读 /var/run/docker.sock（安装时已自动把运行用户加入 docker 组）；
# 指向 socket proxy: DOCKER_HOST=unix:///path/to/proxy.sock
# 彻底禁用: DOCKER_HOST=

# ---- 可选：网络接口/温度传感器白名单（前缀 - 表示黑名单，空串禁用）----
# NICS=eth0
# SENSORS=coretemp*
