# ============================================================
# Beszel TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# Beszel 上游版本（GitHub tag，不带 v 前缀）
BESZEL_VERSION=0.19.0

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 0.19.0-1（beszel release 版本-自行发布版本）
# 注：官方文档对版本号格式的描述已过时，现在不做硬性要求；
# 仍需保证 config.ini / DEBIAN/control / .lang 三处一致，每次提交递增，
# 且 Release tag 须等于该版本（如 v0.19.0-1）
PKG_RELEASE=10

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster 等 NAS）
#   arm64 - ARM64/aarch64 机型
TARGET_ARCH=amd64

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
# 规范：小写字母/数字/连字符，字母开头，≤50 字符
APP_ID=beszelmonitor

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=beszelmonitor

# deb 维护者信息：Maintainer 填打包者（dpkg 语义），publisher/lang auth 填
# 上游开发者（坑 49 署名分工：商店展示“开发者”= henrygd，包问题找 Moechz）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"
PUBLISHER="henrygd"

# ------------------ 二进制来源（V6 红线，坑 31/32/43） ------------------
# source = 从本仓库公开 CI 的源码构建 Release 拉自建产物（上架唯一合法模式）
# compat = 上游官方 Release 预编译二进制（仅本地快速测试，禁止提交商店）
BUILD_MODE=source

# 上游源码锁定（CI 与审核者核对用；进包 PROVENANCE.md）
SRC_COMMIT=ffcdb041670a501611727848649d28d886beb231
GO_VERSION=1.27.1

# 自建二进制 Release（GitHub Actions 公开构建，tag: build-v0.19.0）
BIN_RELEASE_BASE=https://github.com/Moechz/beszel/releases/download/build-v0.19.0
# 双层校验 pin（与 Release 内 SHA256SUMS 独立互验；CI 产出后回填，勿手抄——
# 从 Release 的 SHA256SUMS 文件 sed 回填，坑 48 陷阱 3）
HUB_SHA256_AMD64=dc1f39ce4360c4999bd15c6fd7a67d379a439eb78af3b68fc704d0ee6a8cb387
AGENT_SHA256_AMD64=1a4984f0643068d7e96467710d44cc9a20ef32fb643835964df4976ea88744c0
HUB_SHA256_ARM64=cf02e929c519032b0e007184569132fbecd9ff75f1cd4f6b37e0f8bba41163aa
AGENT_SHA256_ARM64=4ed3a92a97a2ff9faea5ec467e19be23aa6bf11ad437f1a6115e05bfa01f8736
